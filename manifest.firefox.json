{
  "manifest_version": 3,
  "name": "PDFGeek: PDF Tools",
  "short_name": "PDFGeek",
  "version": "1.1.0",
  "description": "Merge, split, crop, rotate and lock PDFs, and turn pictures into PDFs. Everything runs on your computer, nothing is uploaded.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open PDFGeek",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "homepage_url": "https://techygeekshome.info/browser-extensions/pdfgeek/",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdfgeek@techygeekshome.info",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
